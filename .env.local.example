# Used ONLY by the one-time build scripts in scripts/ (npm run data:*).
# The deployed app needs NONE of these — it reads static JSON committed by the build.
# Copy this file to .env.local and fill in your keys. .env.local is gitignored.

# Helius DAS — enumerates Solana collections. Free key from https://dev.helius.xyz
HELIUS_API_KEY=

# OpenSea API v2 — enumerates Ethereum collections + covers.
# Key from https://docs.opensea.io (leave blank to skip the Ethereum collections).
OPENSEA_API_KEY=

# Optional, for `npm run data:contract` (the keyless ERC-721 path). Both default
# to a public endpoint; override if you hit rate limits or want a pinned gateway.
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# IPFS_GATEWAY=https://ipfs.io/ipfs/

# Umami analytics. BOTH must be set or the app ships with no analytics at all —
# no script, no events. Public by design (they appear in the page source), so
# they are safe to commit to a deploy environment. Baked in at BUILD time, so a
# change needs a rebuild + redeploy.
# NEXT_PUBLIC_UMAMI_SRC=https://<your-umami-host>/script.js
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Optional: serve under a subpath (e.g. "/switch" for a GitHub Pages project site).
# Defaults to "" (domain root).
# NEXT_PUBLIC_BASE_PATH=
